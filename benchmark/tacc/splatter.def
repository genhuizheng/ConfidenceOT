Bootstrap: docker
From: rocker/r-ver:4.4.1

# The image the benchmark's Splatter generation runs in.
#
# Built rather than pulled. The account already carries rocker/r-ver-4.4.sif
# and it cannot be installed into: the image has compilers but not the
# development headers Bioconductor needs, and it is read only. Nineteen
# packages went down that way once already. Installing during a build writes
# into the image while it is still writable, so both halves of that problem
# disappear at once.
#
# Built rather than pulling bioconductor/bioconductor_docker because this
# cluster is aarch64 and that image is not published for every architecture.
# rocker/r-ver is multi-arch, so the base resolves on both.
#
# The R version is pinned in the From line and the Bioconductor release in
# %post, so the image is the record of which Splatter produced a dataset --
# and 10_generate_splatter.R writes the version it actually loaded into
# generation.json, so the two can be checked against each other.

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # apt's download method drops privileges to the _apt user before it
    # fetches anything, and setgroups is not permitted inside the user
    # namespace a fakeroot build runs in, so apt-get update dies with
    # "Method http has died unexpectedly" and an exit code that looks like a
    # network failure. Telling apt to stay root is the documented way out.
    printf 'APT::Sandbox::User "root";\n' > /etc/apt/apt.conf.d/99-no-sandbox

    apt-get update
    # The headers, named rather than pulled in by a metapackage, so that a
    # build failure names the library it was missing.
    apt-get install -y --no-install-recommends \
        libxml2-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        zlib1g-dev \
        libglpk-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev
    rm -rf /var/lib/apt/lists/*

    R -q -e 'install.packages(c("BiocManager", "jsonlite", "Matrix"), repos = "https://cloud.r-project.org")'
    R -q -e 'BiocManager::install(version = "3.20", ask = FALSE, update = FALSE)'
    R -q -e 'BiocManager::install(c("splatter", "SingleCellExperiment", "SummarizedExperiment"), ask = FALSE, update = FALSE)'

    # Nothing is verified here. apptainer deletes the image when %post
    # fails, and %post is where the twenty minutes of compilation live, so a
    # mistake in a check costs the whole build. The check runs against the
    # finished image instead, in build_container.slurm, where failing it
    # leaves the image on disk to be re-checked.

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Inside the image the library is the image's own. A host R_LIBS_USER
    # pointing at packages compiled against another R would load here and
    # break in ways that look like Splatter's fault.
    export R_LIBS_USER=/usr/local/lib/R/site-library

%labels
    Purpose ConfidenceOT technical benchmark, Splatter generation
    Base rocker/r-ver:4.4.1
    Bioconductor 3.20

%help
    Rscript inside this image has splatter, SingleCellExperiment, Matrix and
    jsonlite, which is everything benchmark/tacc/10_generate_splatter.R loads.

    Build:   sbatch benchmark/tacc/build_container.slurm
    Use:     CONFIDENCEOT_RSCRIPT=benchmark/tacc/rscript.sh
